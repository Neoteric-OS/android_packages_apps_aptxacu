<?xml version="1.0" encoding="utf-8"?>
<manifest 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionName="15.0.3"
    package="com.qualcomm.qtil.aptxacu">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <uses-permission android:name="com.qualcomm.qtil.aptxals.PERMISSION"/>

    <permission
        android:label="aptxacu_permission"
        android:name="com.qualcomm.qtil.aptxacu.PERMISSION"
        android:protectionLevel="signature"/>

    <application
        android:theme="@style/Theme.AppCompat.DayNight"
        android:label="@string/app_name"
        android:name="com.qualcomm.qtil.aptxacu.aptxacuApplication"
        android:supportsRtl="true"
        android:directBootAware="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:enableOnBackInvokedCallback="true">

        <service
            android:name="com.qualcomm.qtil.aptxacu.aptxacuService"
            android:permission="com.qualcomm.qtil.aptxacu.PERMISSION"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.qualcomm.qtil.aptxacu.aptxacuService"/>
            </intent-filter>
        </service>

        <activity
            android:theme="@style/Theme.SubSettingsBase"
            android:label="@string/acu_label"
            android:name="com.qualcomm.qtil.aptxacu.aptxacuSettingsActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
            </intent-filter>
        </activity>

        <activity
            android:theme="@style/Theme.SubSettingsBase"
            android:label="@string/audio_profile_preference_title"
            android:name="com.qualcomm.qtil.aptxacu.aptxacuProfilePreferenceListActivity"
            android:enabled="true"/>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.qualcomm.qtil.aptxacu.androidx-startup">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup"/>
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup"/>
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup"/>
        </provider>
  
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:permission="android.permission.DUMP"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
